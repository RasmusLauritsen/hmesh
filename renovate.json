{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Keep indirect Go dependencies up to date too",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Automerge non-major updates after checks pass, except pre-1.0 minor updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Leave major updates open for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Review potentially breaking pre-1.0 minor updates manually",
      "matchManagers": ["gomod"],
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    }
  ]
}
